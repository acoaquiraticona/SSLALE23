// ConstanteDecimalX.gv
// Autómata Finito Determinista para el lenguaje X (SumarX)
// Lenguaje: un nombre de Pokémon de los primeros 151
// (Mew = 0, Bulbasaur = 1, ..., Mewtwo = 150)

digraph AFD_SumarX {
    rankdir=LR;
    size="11,6";
    node [shape=circle, fontsize=12, fontname="Helvetica"];
    edge [fontsize=10, fontname="Helvetica"];

    // Estados
    q0  [label="q0\ninicio /\nsaltando espacios"];
    q1  [label="q1\nleyendo\nnombre"];
    qA  [label="qA\naceptación", shape=doublecircle, style=filled, fillcolor="#d4edda"];
    qE  [label="qE\nerror", style=filled, fillcolor="#f8d7da"];

    // Flecha de inicio
    start [shape=point, width=0.15];
    start -> q0;

    // Transiciones
    q0 -> q0  [label="espacio"];
    q0 -> q1  [label="carácter de nombre\n(letra, ♀, ♂, ', .)"];
    q0 -> qE  [label="otro"];

    q1 -> q1  [label="carácter de nombre"];
    q1 -> qA  [label="espacio / \\n / EOF"];
    q1 -> qE  [label="otro"];

    qA -> qA  [label="espacio"];
    qA -> qE  [label="cualquier símbolo"];

    qE -> qE  [label="cualquier símbolo"];

    // Pie de página
    label="\nAFD del lenguaje X – SumarX\nΣ = letras + {♀, ♂, ', ., espacio, \\n}\nUn token = un Pokémon válido de la Pokédex (tabla de 151 nombres)";
    labelloc=b;
    fontsize=11;
}